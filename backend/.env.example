# All variables below are optional - the app runs with sensible fallbacks
# if any are unset (SQLite instead of Postgres, in-memory cache instead of
# Redis, template-based reasoning instead of LLM synthesis, no auth).

# --- Database / broker (falls back to SQLite + in-process async if unset) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trade_intel
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- External data APIs (each has a hardcoded fallback if unset/unreachable) ---
FRED_API_KEY=

# --- LLM synthesis (Decision Agent only) ---
# Falls back to template-based reasoning if unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Write-endpoint auth ---
# If unset, /analyze and /datasets/upload are unauthenticated (dev/demo
# mode). Set this to require a matching X-API-Key header on both routes.
TRADE_API_KEY=
